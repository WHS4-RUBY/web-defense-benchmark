# Immutable image coordinates. Use the Git commit tag produced by CI, not latest.
RUBY_BENCHMARK_IMAGE_PREFIX=ghcr.io/whs4-ruby/web-defense-benchmark
RUBY_BENCHMARK_IMAGE_TAG=replace-with-commit-sha

# The root RUBY Compose project currently creates this network.
RUBY_BENCHMARK_PIPELINE_NETWORK=ruby_ai-defense-net
RUBY_WEB_PUBLIC_ORIGIN=http://example.invalid

# Leave both empty for the normal web. Enabling modules requires a unique
# 32-character lowercase hexadecimal trial ID.
RUBY_WEB_VULNERABILITY_MODULES=
RUBY_WEB_TRIAL_ID=
RUBY_WEB_PREPARATION_SEED=

# Benchmark target proxy (detection/defense 와 분리된 독립 진입점).
# /juice-shop/ 와 /ruby-shop/ 를 하나의 포트로 노출한다.
# 벤치마크 대상 계열은 30xx 로 묶는다(기존 juice-shop 직접 노출이 3010).
# BENCHMARK_PROXY_BIND 는 호스트 바인드 주소(기본 0.0.0.0, 외부 공개).
# 서버에서 특정 인터페이스로만 열려면 주소를 지정한다.
BENCHMARK_PROXY_PORT=3020
BENCHMARK_PROXY_BIND=0.0.0.0
# Juice Shop 구동 모드. 취약점 벤치마크용 기본값은 unsafe.
JUICE_SHOP_NODE_ENV=unsafe

# Replace every value before deployment. Do not commit the resulting .env file.
POSTGRES_PASSWORD=replace-admin-password
POSTGRES_APP_PASSWORD=replace-app-password
POSTGRES_UNTRUSTED_PASSWORD=replace-untrusted-password
POSTGRES_VERIFIER_PASSWORD=replace-verifier-password
RUBY_WEB_OBJECT_ACCESS_KEY=replace-object-access-key
RUBY_WEB_OBJECT_SECRET_KEY=replace-object-secret-key
RUBY_WEB_RESET_TOKEN=replace-reset-token
RUBY_EVALUATOR_TOKEN=replace-evaluator-token
RUBY_WEB_OPERATIONS_DIAGNOSTIC_KEY=replace-scenario-diagnostic-key
